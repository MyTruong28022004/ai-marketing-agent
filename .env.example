# Copy this file to server/.env for local development.
VITE_API_URL="http://localhost:3101/api"
DATABASE_URL="postgresql://milo:milo_dev_password@localhost:55433/milo?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
WEB_ORIGIN="http://localhost:5173"
PORT="3101"

# Uses the local Codex login by default; run `codex login` once on the server.
AI_PROVIDER="codex-local"
CODEX_MODEL=""
# Live web trend research can take several minutes. Override in milliseconds if needed.
CODEX_TREND_TIMEOUT_MS="600000"

# Optional fallback for AI_PROVIDER="openai". Never expose this key through VITE_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

REDIS_URL="redis://localhost:56380"
S3_ENDPOINT="http://localhost:59002"
S3_ACCESS_KEY="milo"
S3_SECRET_KEY="milo_dev_password"
S3_BUCKET="milo-documents"

# Product knowledge vector index. Ollama runs locally and does not require an API key.
CHROMA_URL="http://localhost:8000"
CHROMA_TENANT="default_tenant"
CHROMA_DATABASE="default_database"
CHROMA_TOKEN=""
KNOWLEDGE_INDEXING_ENABLED="false"
EMBEDDING_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="embeddinggemma"

# Facebook App ID, App Secret, and Login Configuration ID are configured per workspace
# in the Social connections screen. This callback endpoint remains shared by the API.
FACEBOOK_REDIRECT_URI="http://localhost:3101/api/integrations/facebook/callback"
FACEBOOK_GRAPH_VERSION="v25.0"
